{
  "name": "auto-tab-grouping",
  "version": "1.0.0",
  "description": "Chrome extension for automatic tab grouping by domain with preset management",
  "main": "background.js",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "build:css": "mkdir -p styles && echo 'CSS build placeholder'",
    "dev": "npm run watch:css",
    "watch:css": "echo 'CSS watch placeholder'",
    "test": "jest",
    "test:legacy": "node test-runner.js",
    "test:unit": "jest --testPathPattern=unit --run",
    "test:integration": "jest --testPathPattern=integration --run",
    "test:watch": "jest --watch",
    "lint": "web-ext lint",
    "lint:fix": "web-ext lint --fix",
    "package": "zip -r auto-tab-grouping.zip . -x 'node_modules/*' '*.git*' 'package-lock.json' '*.md' '.DS_Store'",
    "validate": "web-ext run --target=chromium --start-url=chrome://extensions/"
  },
  "keywords": [
    "chrome-extension",
    "tab-management",
    "productivity",
    "browser-extension",
    "tab-grouping"
  ],
  "author": "Tab Group Manager Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^4.0.0",
    "web-ext": "^7.8.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "bugs": {
    "url": "."
  },
  "homepage": ".",
  "type": "module"
}
