{
  "manifest_version": 3,
  "name": "Tab Group Manager",
  "version": "1.0.0",
  "description": "Automatically group tabs by domain and manage tab presets for better productivity",

  "permissions": ["tabs", "tabGroups", "storage", "activeTab"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/features/popup/popup.html",
    "default_title": "Tab Group Manager",
    "default_icon": "assets/icons/icon.svg"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["navigator.js"],
      "run_at": "document_end"
    }
  ],

  "options_page": "options.html",

  "icons": {
    "128": "assets/icons/icon.svg"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
